{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run local.py with project.yaml",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/local.py",
        "${workspaceFolder}/project.yaml"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
